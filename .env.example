# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-club-attendance-secret-key-change-in-production!
ALLOWED_HOSTS=localhost,127.0.0.1,*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.azurewebsites.net

# Database Settings
# Set DB_ENGINE=mysql when connecting to MySQL / Azure Database for MySQL Flexible Server
# Default is sqlite for instant local development without MySQL service running
DB_ENGINE=sqlite
DB_NAME=club_attendance_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
# DB_SSL_CA=/path/to/DigiCertGlobalRootCA.crt.pem  # For Azure MySQL with SSL

# Email Settings (for Email OTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Club Attendance <noreply@clubattendance.org>

# SMS Gateway Settings (optional external API for Mobile OTP)
SMS_GATEWAY_API_KEY=
